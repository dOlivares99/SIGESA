@model WEB.Models.ViewModels.ContratoFormViewModel

@{
    ViewData["Title"] = "Crear contrato";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="ti ti-arrow-left"></i>
    </a>
    <div>
        <h5 class="fw-bold mb-0">Crear contrato</h5>
        <small class="text-muted">Selecciona una cotización aprobada</small>
    </div>
</div>

<div class="row g-4">

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-body p-4">

                @if (ViewBag.ErrorCotizaciones != null)
                {
                    <div class="alert alert-danger py-2"><i class="ti ti-alert-circle me-1"></i>@ViewBag.ErrorCotizaciones</div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div><i class="ti ti-alert-circle me-1"></i>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CotizacionId" class="form-label fw-medium">Cotización</label>
                        <select asp-for="CotizacionId" class="form-select">
                            <option value="">Seleccione una cotización</option>
                            @foreach (var cotizacion in Model.Cotizaciones)
                            {
                                <option value="@cotizacion.CotizacionId">@cotizacion.TextoOpcion</option>
                            }
                        </select>
                        <span asp-validation-for="CotizacionId" class="text-danger small"></span>
                        @if (Model.Cotizaciones.Count == 0)
                        {
                            <small class="text-muted d-block mt-2">No existen cotizaciones aprobadas disponibles.</small>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Observaciones" class="form-label fw-medium">
                            Observaciones <span class="text-muted fw-normal">(opcional)</span>
                        </label>
                        <textarea asp-for="Observaciones" class="form-control" rows="5"
                                  placeholder="Escriba observaciones adicionales para el contrato"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"
                            @(Model.Cotizaciones.Count == 0 ? "disabled" : null)>
                            <i class="ti ti-device-floppy me-1"></i> Crear contrato
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card h-100" style="background:#f8f7ff;border:1.5px solid #ece9ff;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:#534AB7;">
                        <i class="ti ti-file-plus text-white"></i>
                    </div>
                    <div>
                        <div class="fw-semibold" style="color:#534AB7;">Antes de continuar</div>
                        <small class="text-muted">Generación automática</small>
                    </div>
                </div>
                <hr style="border-color:#ece9ff;">
                <div class="d-flex align-items-start gap-2 mt-3">
                    <i class="ti ti-info-circle mt-1" style="color:#534AB7;"></i>
                    <small class="text-muted">
                        El número del contrato y la fecha de creación se generarán automáticamente.
                    </small>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
