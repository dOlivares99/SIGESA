@model WEB.Models.ViewModels.ContratoFormViewModel

@{
    ViewData["Title"] = "Editar contrato";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="ti ti-arrow-left"></i>
    </a>
    <div>
        <h5 class="fw-bold mb-0">Editar contrato</h5>
        <small class="text-muted">@Model.NumeroContrato</small>
    </div>
</div>

<div class="row g-4">

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-body p-4">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div><i class="ti ti-alert-circle me-1"></i>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="Editar" asp-route-id="@Model.ContratoId" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="ContratoId" type="hidden" />
                    <input asp-for="CotizacionId" type="hidden" />
                    <input asp-for="NumeroContrato" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label fw-medium">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Firmado">Firmado</option>
                            <option value="Cancelado">Cancelado</option>
                            <option value="Anulado">Anulado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Observaciones" class="form-label fw-medium">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="ti ti-device-floppy me-1"></i> Guardar cambios
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card h-100" style="background:#f8f7ff;border:1.5px solid #ece9ff;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:#534AB7;">
                        <i class="ti ti-file-text text-white"></i>
                    </div>
                    <div>
                        <div class="fw-semibold" style="color:#534AB7;">Datos actuales</div>
                        <small class="text-muted">Registro del contrato</small>
                    </div>
                </div>
                <hr style="border-color:#ece9ff;">
                <div class="mb-3">
                    <small class="text-muted d-block mb-1">Número de contrato</small>
                    <span class="fw-medium">@Model.NumeroContrato</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block mb-1">Fecha del contrato</small>
                    <span class="fw-medium">@Model.FechaContrato.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
