@model WEB.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    string ObtenerColorEstado(string estado)
    {
        return estado switch
        {
            "Confirmada" => "#0F6E56",
            "Realizada" => "#1A56DB",
            "Cancelada" => "#993C1D",
            "EnProceso" => "#854F0B",
            "Pendiente" => "#534AB7",
            _ => "#534AB7"
        };
    }

    string ObtenerFondoEstado(string estado)
    {
        return estado switch
        {
            "Confirmada" => "#E6F4F0",
            "Realizada" => "#E8F0FE",
            "Cancelada" => "#FDF0ED",
            "EnProceso" => "#FDF5E6",
            "Pendiente" => "#F0EEFF",
            _ => "#F0EEFF"
        };
    }
}

<style>
    .dash-card {
        border-radius: 16px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        background: white;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
    }

        .dash-card:hover {
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            transform: translateY(-2px);
        }

    .kpi-value {
        font-size: 1.85rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .kpi-value-sm {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .section-title {
        font-size: 0.82rem;
        font-weight: 600;
        color: #534AB7;
        margin-bottom: 10px;
    }

    .list-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
    }

    .mini-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .mini-cal {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: #f0eeff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .estado-bar {
        display: flex;
        height: 14px;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        gap: 2px;
    }

        .estado-bar span {
            display: block;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">Dashboard</h4>

        <div class="text-muted" style="font-size:0.85rem;">
            <i class="ti ti-calendar me-1"></i>
            @Model.MesActual
        </div>
    </div>

    <a asp-controller="Reservas"
       asp-action="Crear"
       class="btn btn-primary px-4">
        <i class="ti ti-plus me-1"></i>
        Nueva reserva
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger py-2 mb-3"
         style="font-size:0.85rem;">
        <i class="ti ti-alert-circle me-1"></i>
        @ViewBag.Error
    </div>
}

@if (Model.TieneSaldosPendientes)
{
    <div class="mb-4 px-3 py-3 rounded d-flex align-items-center gap-2 flex-wrap"
         style="background:#FDF5E6; border-left:3px solid #854F0B;">

        <i class="ti ti-alert-triangle"
           style="color:#854F0B; font-size:1rem;">
        </i>

        <span style="color:#854F0B; font-size:0.82rem; font-weight:600;">
            @Model.AlertasSaldo.Count evento(s) con saldo pendiente próximo:
        </span>

        @foreach (var alerta in Model.AlertasSaldo)
        {
            <span class="badge rounded-pill"
                  style="background:rgba(133,79,11,0.12);
                color:#854F0B;
                font-size:0.72rem;
                font-weight:500;">
                @alerta.ClienteNombre · ₡@alerta.SaldoPendiente.ToString("N0")
            </span>
        }
    </div>
}

<div class="row g-3 mb-3">

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="dash-card p-4 h-100">

            <div class="mini-icon mb-3"
                 style="background:#534AB7; width:44px; height:44px; border-radius:12px;">
                <i class="ti ti-calendar-event"
                   style="color:#fff; font-size:1.1rem;">
                </i>
            </div>

            <div class="kpi-value"
                 style="color:#534AB7;">
                @Model.EventosMes
            </div>

            <small class="text-muted"
                   style="font-size:0.76rem;">
                Eventos del mes
            </small>

            @if (Model.EventosMes == 0)
            {
                <div style="font-size:0.68rem; color:#AAA;">
                    Sin eventos
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="dash-card p-4 h-100">

            <div class="mini-icon mb-3"
                 style="background:#0F6E56; width:44px; height:44px; border-radius:12px;">
                <i class="ti ti-cash"
                   style="color:#fff; font-size:1.1rem;">
                </i>
            </div>

            <div class="kpi-value-sm"
                 style="color:#0F6E56;">
                ₡@Model.IngresosMes.ToString("N0")
            </div>

            <small class="text-muted"
                   style="font-size:0.76rem;">
                Ingresos del mes
            </small>

            @if (Model.IngresosMes == 0)
            {
                <div style="font-size:0.68rem; color:#AAA;">
                    Sin ingresos
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="dash-card p-4 h-100">

            <div class="mini-icon mb-3"
                 style="background:#993C1D; width:44px; height:44px; border-radius:12px;">
                <i class="ti ti-clock-dollar"
                   style="color:#fff; font-size:1.1rem;">
                </i>
            </div>

            <div class="kpi-value-sm"
                 style="color:#993C1D;">
                ₡@Model.SaldoPendienteTotal.ToString("N0")
            </div>

            <small class="text-muted"
                   style="font-size:0.76rem;">
                Saldo pendiente
            </small>

            @if (Model.SaldoPendienteTotal == 0)
            {
                <div style="font-size:0.68rem; color:#AAA;">
                    Todo saldado
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="dash-card p-4 h-100">

            <div class="mini-icon mb-3"
                 style="background:#1A56DB; width:44px; height:44px; border-radius:12px;">
                <i class="ti ti-users"
                   style="color:#fff; font-size:1.1rem;">
                </i>
            </div>

            <div class="kpi-value"
                 style="color:#1A56DB;">
                @Model.TotalClientes
            </div>

            <small class="text-muted"
                   style="font-size:0.76rem;">
                Clientes
            </small>
        </div>
    </div>

</div>

<div class="row g-3">

    <div class="col-12 col-lg-5">
        <div class="dash-card p-4 h-100">

            <div class="section-title">
                <i class="ti ti-chart-bar me-1"></i>
                Eventos por mes @DateTime.Now.Year
            </div>

            @if (Model.GraficaMeses == null ||
                 !Model.GraficaMeses.Any() ||
                 Model.GraficaMeses.All(m => m.Cantidad == 0))
            {
                <div class="text-center text-muted py-4"
                     style="font-size:0.82rem;">
                    Sin eventos este año
                </div>
            }
            else
            {
                <canvas id="chartEventos"
                        height="220">
                </canvas>
            }

        </div>
    </div>

    <div class="col-12 col-lg-2">
        <div class="dash-card p-3 h-100">

            <div class="section-title">
                <i class="ti ti-list-details me-1"></i>
                Estados
            </div>

            @if (Model.PorEstado == null ||
                 !Model.PorEstado.Any() ||
                 Model.PorEstado.All(e => e.Cantidad == 0))
            {
                <div class="text-muted text-center py-2"
                     style="font-size:0.78rem;">
                    Sin datos
                </div>
            }
            else
            {
                <div class="estado-bar mb-3">
                    @foreach (var estado in Model.PorEstado.Where(e => e.Cantidad > 0))
                    {
                        <span style="@($"flex-grow:{estado.Cantidad}; flex-basis:0; background-color:{ObtenerColorEstado(estado.Estado)};")"></span>
                    }
                </div>

                @foreach (var estado in Model.PorEstado)
                {
                    var colorEstado = ObtenerColorEstado(estado.Estado);
                    var colorFondo = ObtenerFondoEstado(estado.Estado);

                    <div class="list-card justify-content-between mb-2"
                         style="background:@colorFondo; padding:7px 10px;">

                        <div class="d-flex align-items-center gap-2">

                            <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:@colorEstado; flex-shrink:0;">
                            </span>

                            <span style="font-size:0.74rem; color:#555;">
                                @estado.Estado
                            </span>

                        </div>

                        <span class="fw-bold"
                              style="font-size:0.76rem; color:@colorEstado;">
                            @estado.Cantidad
                        </span>

                    </div>
                }
            }

        </div>
    </div>

    <div class="col-12 col-lg-3">
        <div class="dash-card p-3 h-100">

            <div class="d-flex justify-content-between align-items-center mb-2">

                <div class="section-title mb-0">
                    <i class="ti ti-calendar-time me-1"></i>
                    Próximos eventos
                </div>

                <a asp-controller="Reservas"
                   asp-action="Index"
                   style="font-size:0.74rem; color:#534AB7;">
                    Ver todos
                </a>

            </div>

            @if (Model.ProximosEventos == null || !Model.ProximosEventos.Any())
            {
                <div class="text-center text-muted py-4"
                     style="font-size:0.8rem;">
                    Sin eventos próximos
                </div>
            }
            else
            {
                foreach (var evento in Model.ProximosEventos)
                {
                    var colorTexto = ObtenerColorEstado(evento.Estado);
                    var colorFondo = ObtenerFondoEstado(evento.Estado);
                    var fechaValida = DateTime.TryParse(
                        evento.FechaEvento,
                        out var fechaEvento
                    );

                    <div class="list-card mb-2" style="background:@colorFondo;">

                        <div class="mini-cal" style="background:#fff;">

                            @if (fechaValida)
                            {
                                <span class="fw-bold"
                                      style="color:#534AB7;
                                    font-size:0.9rem;
                                    line-height:1;">
                                    @fechaEvento.Day
                                </span>

                                <span style="color:#534AB7;
                                    font-size:0.6rem;
                                    line-height:1;">
                                    @fechaEvento.ToString("MMM").ToUpper()
                                </span>
                            }
                            else
                            {
                                <span class="fw-bold"
                                      style="color:#534AB7; font-size:0.75rem;">
                                    --
                                </span>
                            }

                        </div>

                        <div class="flex-grow-1 overflow-hidden">

                            <div class="text-truncate fw-medium"
                                 style="font-size:0.8rem;">
                                @evento.ClienteNombre
                            </div>

                            <div class="text-truncate text-muted"
                                 style="font-size:0.7rem;">
                                @evento.TipoEvento
                            </div>

                        </div>

                        <div class="text-end flex-shrink-0">

                            <div class="fw-bold"
                                 style="color:@colorTexto; font-size:0.72rem;">
                                @evento.Estado
                            </div>

                            @if (evento.SaldoPendiente > 0)
                            {
                                <small class="text-danger d-block"
                                       style="font-size:0.65rem;">
                                    ₡@evento.SaldoPendiente.ToString("N0")
                                </small>
                            }

                        </div>

                    </div>
                }
            }

        </div>
    </div>

    <div class="col-12 col-lg-2">
        <div class="dash-card p-3 h-100">

            <div class="d-flex justify-content-between align-items-center mb-2">

                <div class="section-title mb-0">
                    <i class="ti ti-receipt me-1"></i>
                    Últimos pagos
                </div>

                <a asp-controller="Pagos"
                   asp-action="Index"
                   style="font-size:0.74rem; color:#534AB7;">
                    Ver
                </a>

            </div>

            @if (Model.UltimosPagos == null || !Model.UltimosPagos.Any())
            {
                <div class="text-center text-muted py-4"
                     style="font-size:0.8rem;">
                    Sin pagos
                </div>
            }
            else
            {
                foreach (var pago in Model.UltimosPagos)
                {
                    <div class="list-card mb-2" style="background:#E6F4F0;">

                        <div class="mini-icon"
                             style="background:#0F6E56; border-radius:12px;">
                            <i class="ti ti-cash"
                               style="color:#fff; font-size:0.85rem;">
                            </i>
                        </div>

                        <div class="flex-grow-1 overflow-hidden">

                            <div class="text-truncate fw-medium"
                                 style="font-size:0.78rem;">
                                @pago.ClienteNombre
                            </div>

                            <div class="text-muted text-truncate"
                                 style="font-size:0.66rem;">
                                @pago.FechaPago
                            </div>

                        </div>

                        <div class="fw-bold text-nowrap"
                             style="color:#0F6E56; font-size:0.78rem;">
                            ₡@pago.Monto.ToString("N0")
                        </div>

                    </div>
                }
            }

        </div>
    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const ctxBarras = document.getElementById('chartEventos');

            if (ctxBarras) {
                const labels = @Html.Raw(
                                                    System.Text.Json.JsonSerializer.Serialize(
                                                            Model.GraficaMeses.Select(m => m.Mes)
                                    )
                                    );

                const datos = @Html.Raw(
                                                    System.Text.Json.JsonSerializer.Serialize(
                                                            Model.GraficaMeses.Select(m => m.Cantidad)
                                    )
                                    );

                const maxVal = datos.length > 0
                    ? Math.max(...datos)
                    : 0;

                new Chart(ctxBarras, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: datos,
                            backgroundColor: datos.map(function(valor) {
                                return valor === maxVal && maxVal > 0
                                    ? '#534AB7'
                                    : '#DDD9FF';
                            }),
                            borderRadius: 4,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const cantidad = context.parsed.y;

                                        return ' ' +
                                            cantidad +
                                            ' evento' +
                                            (cantidad !== 1 ? 's' : '');
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1,
                                    color: '#6C757D',
                                    font: {
                                        size: 10
                                    }
                                },
                                grid: {
                                    color: '#F0EEFF'
                                }
                            },
                            x: {
                                ticks: {
                                    color: '#6C757D',
                                    font: {
                                        size: 10
                                    }
                                },
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }

        });
    </script>
}
